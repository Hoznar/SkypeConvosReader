<UserControl x:Class="SkypeConvosReader.Controls.Avatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SkypeConvosReader.Controls"
             Height="40" Width="40">
    
    <Border x:Name="AvatarBorder" BorderBrush="Gainsboro" BorderThickness="1"
            Background="{Binding AvatarColor, RelativeSource={RelativeSource AncestorType=UserControl}}">

        <Grid>
            <!-- Profile picture -->
            <Image x:Name="AvatarImageControl" 
                   Source="{Binding AvatarImage, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   Stretch="UniformToFill" Visibility="Collapsed"/>
            
            
            <!-- Fallback letter -->
            <TextBlock x:Name="AvatarLetterControl" 
                       Text="{Binding AvatarLetter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
        </Grid>
    </Border>
</UserControl>
