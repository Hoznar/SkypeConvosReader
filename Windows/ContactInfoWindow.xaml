<Window x:Class="SkypeConvosReader.Windows.ContactInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SkypeConvosReader.Windows"
        xmlns:controls="clr-namespace:SkypeConvosReader.Controls"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Contact" Height="450" Width="500">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="0,0,0,10" BorderBrush="#D8E5EF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:Avatar Width="90" Height="90"
                                     AvatarImage="{Binding Avatar.Image}" AvatarLetter="{Binding Avatar.Letter}"
                                     AvatarColor="{Binding Avatar.Color}" HasAvatar="{Binding Avatar.HasImage}"/>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SkypeName}" Opacity="0.6" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Mood}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- About -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="About" Foreground="#0B99DF" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding About}" TextWrapping="Wrap"/>
            </StackPanel>
            
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,24,0,0">
                    <TextBlock Text="Basic Information" Foreground="#0B99DF" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#666666" Text="Gender:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gender}"/>

                        <TextBlock Grid.Row="1" Foreground="#666666" Text="Birthday:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Birthday}"/>

                        <TextBlock Grid.Row="2" Foreground="#666666" Text="Country:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Country}"/>

                        <TextBlock Grid.Row="3" Foreground="#666666" Text="Province:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Province}"/>

                        <TextBlock Grid.Row="4" Foreground="#666666" Text="City:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding City}"/>
                    </Grid>
                </StackPanel>

                <!-- Additional information -->
                <StackPanel Grid.Column="1" Margin="0,24,0,0">
                    <TextBlock Text="Additional Information" Foreground="#0B99DF" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#666666" Text="Phone:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Phone}"/>
                        <TextBlock Grid.Row="1" Foreground="#666666" Text="Website:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Website}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
