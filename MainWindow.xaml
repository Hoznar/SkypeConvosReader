<Window x:Class="SkypeConvosReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SkypeConvosReader.Models"
        xmlns:local="clr-namespace:SkypeConvosReader"
        xmlns:controls="clr-namespace:SkypeConvosReader.Controls"
        xmlns:data="clr-namespace:SkypeConvosReader.Data"
        mc:Ignorable="d"
        Title="Skype Archive" Width="1200" Height="750"
        MinWidth="900" MinHeight="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        
        <Border Grid.Column="0" Background="#F0FAFC" BorderBrush="#B5DDE9" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="175"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Account -->
                <Border Grid.Row="0" Padding="20,20,20,0" Background="#00B1F4">
                    <StackPanel>
                        <TextBlock Text="Account" Foreground="#FFFBFF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <controls:Avatar Grid.Column="0" Width="56" Height="56" BorderBrush="#0099DC" BorderThickness="3"
                                             AvatarImage="{Binding CurrentAccount.Avatar.Image}" AvatarLetter="{Binding CurrentAccount.Avatar.Letter}"
                                             AvatarColor="{Binding CurrentAccount.Avatar.Color}" HasAvatar="{Binding CurrentAccount.Avatar.HasImage}"/>
                            
                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                <TextBlock Text="{Binding CurrentAccount.FullName}" Foreground="#FFFBFF" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentAccount.SkypeName}" Foreground="#FFFBFF" FontSize="13" Opacity="0.6" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <Button Content="Load Database" Height="32" Margin="0,18,0,0"
                                Background="#FFFBFF" Foreground="#00B1F4" FontWeight="SemiBold"
                                BorderThickness="2" BorderBrush="#0099DC"/>
                        
                    </StackPanel>
                </Border>
                
                <!-- Conversations -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        
                    <TextBlock Text="Conversations" Foreground="#0B99DF" FontSize="12" FontWeight="SemiBold" Margin="20,20,20,10"/>
                    
                    <!-- Search -->
                    <Grid Grid.Row="1" Margin="20,0,20,10">
                        <TextBox x:Name="ConversationSearchBox"
                                 Height="32" Padding="10,0" VerticalContentAlignment="Center" 
                                 Text="{Binding ConversationSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search conversations..." Foreground="#999999" Margin="10,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <!-- Sort -->
                    <Grid Grid.Row="2" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0" Height="32" Style="{StaticResource SkypeComboBox}" 
                                  SelectedValue="{Binding ConversationSort}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Last message" Tag="{x:Static data:ConversationSort.LastMessage}"/>
                            <ComboBoxItem Content="Name" Tag="{x:Static data:ConversationSort.Name}"/>
                            <ComboBoxItem Content="Messages" Tag="{x:Static data:ConversationSort.MessageCount}"/>
                            <ComboBoxItem Content="First message" Tag="{x:Static data:ConversationSort.FirstMessage}"/>
                        </ComboBox>
                        
                        <Button Grid.Column="1" Width="32" Height="32" Margin="6,0,0,0"
                            Content="{Binding SortDirectionIcon}" Click="SortDirectionButton_Click"
                            Background="#0099DC" BorderThickness="0" Foreground="#FFFBFF"/>
                    </Grid>
                    
                    <ListBox Grid.Row="3" 
                             ItemsSource="{Binding ConversationsView}" 
                             ItemContainerStyle="{StaticResource SkypeListBoxItem}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0,1,0,0"
                             BorderBrush="#B5DDE9"
                             ScrollViewer.CanContentScroll="False">
                        
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBar}" />
                        </ListBox.Resources>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                
                                <Border BorderBrush="#D8E5EF" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <controls:Avatar Grid.Column="0" Width="40" Height="40" 
                                                      AvatarImage="{Binding Avatar.Image}" AvatarLetter="{Binding Avatar.Letter}"
                                                      AvatarColor="{Binding Avatar.Color}" HasAvatar="{Binding Avatar.HasImage}"/>
                                        
                                        <!-- Information -->
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DisplayNameShort}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Conversation.LastMessageDate, StringFormat={}{0:dd/MM/yyyy}}" Opacity="0.6"/>
                                            <TextBlock Grid.Row="2" Text="{Binding MessageCountAsString}" Opacity="0.6"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </Grid>
            </Grid>
            
            
        </Border>
        
        <!-- Main -->
        
        <Grid Grid.Column="1">
            
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </Grid.Resources>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Visibility="{Binding IsConversationNotSelected, Converter={StaticResource BoolToVisibility}}">
                
                <TextBlock Text="o" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a conversation" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a conversation from the list to view its messages." Opacity="0.6" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            
            <Grid Visibility="{Binding IsConversationSelected, Converter={StaticResource BoolToVisibility}}">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    
                    <controls:Avatar Grid.Column="0" Width="56" Height="56"
                                     AvatarImage="{Binding SelectedConversation.Avatar.Image}" AvatarLetter="{Binding SelectedConversation.Avatar.Letter}"
                                     AvatarColor="{Binding SelectedConversation.Avatar.Color}" HasAvatar="{Binding SelectedConversation.Avatar.HasImage}"/>
                            
                    <StackPanel Grid.Column="1" Margin="12,3,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedConversation.Conversation.DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedConversation.MessageCountAsString}" FontSize="13" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Margin="12,3,0,0" VerticalAlignment="Center">
                        <ComboBox Margin="0,0,10,0"/>
                        <ComboBox Margin="0,5,10,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Messages -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="MessagesListBox" ItemsSource="{Binding Messages}" Loaded="MessagesListBox_Loaded" ScrollViewer.CanContentScroll="False"
                             BorderThickness="0,1" BorderBrush="#D8E5EF" Background="Transparent" ItemContainerStyle="{StaticResource MessageListBoxItem}">    
                             
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                
                                <Grid Margin="10">
                                    <Grid MaxWidth="650">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Click="Contact_Click" Background="Transparent" BorderThickness="0" Padding="0">
                                                <controls:Avatar Width="40" Height="40"
                                                                 AvatarImage="{Binding Avatar.Image}" AvatarLetter="{Binding Avatar.Letter}"
                                                                 AvatarColor="{Binding Avatar.Color}" HasAvatar="{Binding Avatar.HasImage}"/>
                                            </Button>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" 
                                                       Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                        
                                        <Border Grid.Row="1" CornerRadius="12" Padding="12,8" Margin="48,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#C7EDFC"/>
                                                
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Background" Value="#E5F7FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            
                                            <TextBox Background="Transparent" BorderThickness="0"
                                                     Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>
                                        
                                    </Grid>
                                </Grid>
                                
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                
                <Grid Grid.Row="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Margin="0">
                        <TextBox x:Name="MessageSearchBox" Height="32" Margin="10,0" VerticalContentAlignment="Center" 
                                 Text="{Binding MessageSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search in messages..." Foreground="#999999" Margin="20,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <DatePicker Grid.Column="1" Width="120" Height="32" Margin="6,0,6,0"
                                SelectedDate="{Binding MessageDateFrom, Mode=TwoWay}"/>
                    
                    <DatePicker Grid.Column="2" Width="120" Height="32" Margin="6,0,6,0"
                                SelectedDate="{Binding MessageDateTo, Mode=TwoWay}"/>
                </Grid>
                
            </Grid>
            
        </Grid>
    </Grid>
</Window>
