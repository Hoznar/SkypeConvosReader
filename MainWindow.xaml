<Window x:Class="SkypeConvosReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SkypeConvosReader.Models"
        xmlns:local="clr-namespace:SkypeConvosReader"
        xmlns:controls="clr-namespace:SkypeConvosReader.Controls"
        xmlns:data="clr-namespace:SkypeConvosReader.Data"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Skype Archive" Width="1200" Height="750"
        MinWidth="900" MinHeight="600">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                Background="{StaticResource SidebarBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="175"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Account -->
                <Border Grid.Row="0" Padding="20,20,20,0" Background="#00B1F4">
                    <StackPanel>
                        <TextBlock Text="Account" Foreground="{StaticResource WhiteBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Click="Contact_Click" Style="{StaticResource ClickablePersonButton}" Tag="{Binding CurrentAccount}">
                                <controls:Avatar Grid.Column="0" Width="56" Height="56" BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="3"
                                                 AvatarImage="{Binding CurrentAccount.Avatar.Image}" AvatarLetter="{Binding CurrentAccount.Avatar.Letter}"
                                                 AvatarColor="{Binding CurrentAccount.Avatar.Color}" HasAvatar="{Binding CurrentAccount.Avatar.HasImage}"/>
                            </Button>
                            
                            <StackPanel Grid.Column="1" Margin="12,3,0,0">
                                <TextBlock Text="{Binding CurrentAccount.FullName}" Foreground="{StaticResource WhiteBrush}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentAccount.SkypeName}" Foreground="{StaticResource WhiteBrush}" FontSize="13" Opacity="0.6" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        
                        <Button Content="Load Database" Click="LoadDatabase_Click" Height="32" Margin="0,18,0,0"
                                Background="#FFFBFF" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                BorderThickness="2" BorderBrush="{StaticResource PrimaryDarkBrush}"/>
                        
                    </StackPanel>
                </Border>
                
                <!-- Conversations -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                        
                    <TextBlock Text="Conversations" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="20,20,20,10"/>
                    
                    <!-- Search -->
                    <Grid Grid.Row="1" Margin="20,0,20,10">
                        <TextBox x:Name="ConversationSearchBox"
                                 Height="32" Padding="10,0" VerticalContentAlignment="Center" 
                                 Text="{Binding ConversationSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search conversations..." Foreground="{StaticResource MutedTextBrush}" Margin="10,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <!-- Sort -->
                    <Grid Grid.Row="2" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0" Height="32" Style="{StaticResource SkypeComboBox}" 
                                  SelectedValue="{Binding ConversationSort}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Last message" Tag="{x:Static data:ConversationSort.LastMessage}"/>
                            <ComboBoxItem Content="Name" Tag="{x:Static data:ConversationSort.Name}"/>
                            <ComboBoxItem Content="Messages" Tag="{x:Static data:ConversationSort.MessageCount}"/>
                            <ComboBoxItem Content="First message" Tag="{x:Static data:ConversationSort.FirstMessage}"/>
                        </ComboBox>
                        
                        <Button Grid.Column="1" Width="32" Height="32" Margin="6,0,0,0"
                            Content="{Binding SortDirectionIcon}" Click="SortDirectionButton_Click"
                            Background="{StaticResource PrimaryDarkBrush}" BorderThickness="0" Foreground="{StaticResource WhiteBrush}"/>
                    </Grid>
                    
                    <ListBox Grid.Row="3" 
                             ItemsSource="{Binding ConversationsView}" 
                             ItemContainerStyle="{StaticResource SkypeListBoxItem}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0,1,0,0"
                             BorderBrush="{StaticResource BorderBrush}"
                             ScrollViewer.CanContentScroll="False">
                        
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBar}" />
                        </ListBox.Resources>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                
                                <Border BorderBrush="{StaticResource LightBorderBrush}" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <controls:Avatar Grid.Column="0" Width="40" Height="40" 
                                                      AvatarImage="{Binding Avatar.Image}" AvatarLetter="{Binding Avatar.Letter}"
                                                      AvatarColor="{Binding Avatar.Color}" HasAvatar="{Binding Avatar.HasImage}"/>
                                        
                                        <!-- Information -->
                                        <Grid Grid.Column="1" Margin="10,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DisplayNameShort}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Conversation.LastMessageDate, StringFormat={}{0:dd/MM/yyyy}}" Opacity="0.6"/>
                                            <TextBlock Grid.Row="2" Text="{Binding MessageCountAsString}" Opacity="0.6"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </Grid>
            </Grid>
            
            
        </Border>
        
        <!-- Main -->
        
        <Grid Grid.Column="1">
            
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            </Grid.Resources>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Visibility="{Binding IsConversationNotSelected, Converter={StaticResource BoolToVisibility}}">
                
                <Image Source="/Assets/speech-bubble.png" Width="80" Height="80" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a conversation" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           Margin="0,15,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a conversation from the list to view its messages." Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            
            <Grid Visibility="{Binding IsConversationSelected, Converter={StaticResource BoolToVisibility}}">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Style="{StaticResource ClickablePersonButton}" Click="Contact_Click" Tag="{Binding SelectedConversation}">
                        <controls:Avatar Width="56" Height="56"
                                         AvatarImage="{Binding SelectedConversation.Avatar.Image}" AvatarLetter="{Binding SelectedConversation.Avatar.Letter}"
                                         AvatarColor="{Binding SelectedConversation.Avatar.Color}" HasAvatar="{Binding SelectedConversation.Avatar.HasImage}"/>
                    </Button>
                            
                    <StackPanel Grid.Column="1" Margin="12,3,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedConversation.Conversation.DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedConversation.Description}" FontSize="13" Opacity="0.6" Margin="0,3,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Width="100" VerticalAlignment="Center">
                        <TextBlock Text="Order by:" HorizontalAlignment="Left" Margin="0,0,0,5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <Button Width="100" Height="35"
                                Content="{Binding OrderMessagesText}" Click="OrderMessagesByButton_Click"
                                Background="{StaticResource PrimaryDarkBrush}" BorderThickness="0" Foreground="{StaticResource WhiteBrush}"/>
                    </StackPanel>
                </Grid>
                
                <!-- Messages -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="MessagesListBox" ItemsSource="{Binding MessagesView}" 
                             Loaded="MessagesListBox_Loaded" ScrollViewer.CanContentScroll="False"
                             BorderThickness="0,1" BorderBrush="{StaticResource LightBorderBrush}" Background="Transparent" 
                             ItemContainerStyle="{StaticResource MessageListBoxItem}">
                        
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="20,16,20,10">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Height="1" Background="{StaticResource LightBorderBrush}" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Name, StringFormat={}{0:dd/MM/yyyy}}"
                                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="12,0"/>

                                            <Border Grid.Column="2" Height="1" Background="{StaticResource LightBorderBrush}" VerticalAlignment="Center"/>

                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                             
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                
                                <Grid Margin="10">
                                    <Grid MaxWidth="650">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                
                                                <Style.Triggers>
                                                    <!-- Don't use normal message style if it's a system message -->
                                                    <DataTrigger Binding="{Binding IsSystemMessage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    
                                                    <!-- Align self depending on who owns the message -->
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Message owner + Date -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Button Click="Contact_Click" Style="{StaticResource ClickablePersonButton}" Tag="{Binding}">
                                                <controls:Avatar Width="40" Height="40"
                                                                 AvatarImage="{Binding Avatar.Image}" AvatarLetter="{Binding Avatar.Letter}"
                                                                 AvatarColor="{Binding Avatar.Color}" HasAvatar="{Binding Avatar.HasImage}"/>
                                            </Button>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat={}{0:HH:mm}}"
                                                       Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                        
                                        <!-- Message Bubble -->
                                        <Border Grid.Row="1" CornerRadius="12" Padding="12,8" Margin="48,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <!-- User is not owner -->
                                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                
                                                    <Style.Triggers>
                                                        <!-- User is owner -->
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            
                                            <TextBox Background="Transparent" BorderThickness="0"
                                                     Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Is System Message -->
                                    <Grid MaxWidth="650">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <!-- Hide system message if normal message -->
                                                    <DataTrigger Binding="{Binding IsSystemMessage}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       TextAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                                            
                                            <TextBlock Text="{Binding Date, StringFormat={}{0:HH:mm}}"
                                                       TextAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                
                <Grid Grid.Row="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Margin="0">
                        <TextBox x:Name="MessageSearchBox" Height="32" Margin="10,0" VerticalContentAlignment="Center" 
                                 Text="{Binding MessageSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search in messages..." Foreground="{StaticResource MutedTextBrush}" Margin="20,0" 
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ConversationSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                        
                        <TextBlock Text="From:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        
                        <DatePicker Width="120" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    BorderThickness="2" BorderBrush="{StaticResource PrimaryDarkBrush}"
                                    SelectedDate="{Binding MessageDateFrom, Mode=TwoWay}"
                                    DisplayDate="{Binding SelectedConversation.Conversation.FirstMessageDate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                        
                        <TextBlock Text="To:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        
                        <DatePicker Width="120" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                    Foreground="{StaticResource MutedTextBrush}" 
                                    BorderThickness="2" BorderBrush="{StaticResource PrimaryDarkBrush}"
                                    SelectedDate="{Binding MessageDateTo, Mode=TwoWay}"
                                    DisplayDate="{Binding SelectedConversation.Conversation.LastMessageDate}"/>
                    </StackPanel>
                </Grid>
                
            </Grid>
            
        </Grid>
    </Grid>
</Window>
